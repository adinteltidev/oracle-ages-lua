BLOCK_RULE1(sync_awake, enabled)
BLOCK_RULE1(sync_eligible, tile)
BLOCK_RULE2(water_exists, subid, flooding_flag)
BLOCK_RULE1(water_initial_side, subid)
BLOCK_RULE2(water_direction_match, direction, required_direction)
BLOCK_RULE_FLAG(water_advance, countdown_elapsed)
BLOCK_RULE1(panel_opened, room_flag_40)
BLOCK_RULE1(panel_trigger, active_triggers)
BLOCK_RULE1(panel_right, subid)
BLOCK_RULE1(panel_move_tick, rotated_frame_counter)
BLOCK_RULE_FLAG(panel_advance, countdown_elapsed)
BLOCK_RULE1(tiles_end, token)
BLOCK_RULE1(tiles_new_group, position_token)
BLOCK_RULE2(tiles_match, actual_tile, expected_tile)
BLOCK_RULE2(puzzle_cube_position, cube_position, required_position)
BLOCK_RULE2(puzzle_cube_color, masked_color, required_color)
BLOCK_RULE1(puzzle_cube_valid_color, wrapped_floor_color)
BLOCK_RULE1(panels_torch_count, torches_lit)
BLOCK_RULE1(panels_all_triggers, active_triggers)
BLOCK_RULE1(panels_wait_opened, active_triggers)
BLOCK_RULE1(statue_placed, tile)
BLOCK_RULE1(trap_route_open, collision)
BLOCK_RULE1(trap_skip_corner, remaining_offsets)
BLOCK_RULE1(trap_solid_tile, tile)
BLOCK_RULE1(trap_all_checked, remaining_offsets)
BLOCK_RULE_FLAG(trap_advance, countdown_elapsed)
