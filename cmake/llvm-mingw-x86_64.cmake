# Portable LLVM-MinGW UCRT toolchain. Pass -DORACLES_LLVM_MINGW=/path/to/toolchain.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(ORACLES_LLVM_MINGW "$ENV{ORACLES_LLVM_MINGW}" CACHE PATH "LLVM-MinGW installation")
if(NOT EXISTS "${ORACLES_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
  message(FATAL_ERROR "Set ORACLES_LLVM_MINGW to a complete LLVM-MinGW installation")
endif()
set(CMAKE_C_COMPILER "${ORACLES_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${ORACLES_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${ORACLES_LLVM_MINGW}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_AR "${ORACLES_LLVM_MINGW}/bin/llvm-ar")
set(CMAKE_RANLIB "${ORACLES_LLVM_MINGW}/bin/llvm-ranlib")
set(CMAKE_FIND_ROOT_PATH "${ORACLES_LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ORACLES_LLVM_MINGW)
